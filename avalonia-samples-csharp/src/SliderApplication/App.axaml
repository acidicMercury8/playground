<Application
    x:Class="SliderApplication.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:SliderApplication"
    RequestedThemeVariant="Default">
    <Application.DataTemplates>
        <l:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <SimpleTheme />
    </Application.Styles>
</Application>
